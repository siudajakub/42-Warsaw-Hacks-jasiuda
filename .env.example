# ---------------------------------------------------------------------------
# 42 HIGHLIGHTS configuration
#
# Copy to `.env` and fill in the two required credentials. The wall always
# uses the live 42 API and fails clearly when credentials are missing.
# ---------------------------------------------------------------------------

# --- 42 API credentials ----------------------------------------------------
# Create an app at https://profile.intra.42.fr/oauth/applications/new
# Scopes: everything the wall reads is covered by `public`. The client asks for
# `public projects` anyway (src/lib/ft/client.ts) — `projects` costs nothing and
# covers us if a read we want later moves behind it. See docs/01-API.md.
# There is no redirect URI to configure: the wall uses the client_credentials
# grant, because a TV in a hallway has no user to log in.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- What to show ----------------------------------------------------------
# 67 = 42 Warsaw. 21 = 42cursus (the Common Core).
# Careful: cursus 67 is "42 events", a different resource entirely.
FT_CAMPUS_ID=67
FT_CURSUS_ID=21

# Rolling celebration window, in days.
HIGHLIGHTS_WINDOW_DAYS=7

# How often the server rebuilds the snapshot, in seconds.
# The real call count depends on roster size, pagination and retries. The
# per-run budget below is the hard safety limit.
HIGHLIGHTS_REFRESH_SECONDS=600

# Hard ceiling on API calls per rebuild. A runaway pagination loop degrades
# into a partial snapshot instead of burning the hourly budget.
HIGHLIGHTS_MAX_API_CALLS=220

# Where the last good snapshot is persisted, so a restart is a warm start.
HIGHLIGHTS_CACHE_PATH=.cache/snapshot.json

# Optional shared secret for POST /api/refresh. Leave empty on a trusted LAN.
# Set it if the box is reachable from the internet.
HIGHLIGHTS_REFRESH_TOKEN=
