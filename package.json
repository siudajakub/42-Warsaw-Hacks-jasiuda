{
  "name": "42-highlights",
  "version": "1.0.0",
  "private": true,
  "description": "42 HIGHLIGHTS — a TV-wall dashboard for the 42 Warsaw Social Space, powered by the 42 Intra API.",
  "scripts": {
    "dev": "next dev -p 4242",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "PORT=4242 HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "motion": "^11.15.0",
    "next": "15.5.22",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
